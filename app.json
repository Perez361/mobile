{
  "expo": {
    "name": "ImportFlow PRO",
    "slug": "importflow",
    "version": "1.0.0",
    "scheme": "importflow",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.importflow.pro",
      "infoPlist": {
        "NSCameraUsageDescription": "ImportFlow PRO uses your camera to upload product photos.",
        "NSPhotoLibraryUsageDescription": "ImportFlow PRO accesses your photo library to upload product photos.",
        "NSPhotoLibraryAddUsageDescription": "ImportFlow PRO saves photos to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.importflow.pro",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ImportFlow PRO accesses your photos to upload product images.",
          "cameraPermission": "ImportFlow PRO uses your camera to take product photos."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "66537040-2868-4129-bb34-d6c462332352"
      }
    },
    "owner": "dreaz-dev-labs"
  }
}
